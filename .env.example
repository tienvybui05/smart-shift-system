POSTGRES_DB=smart_shift_db
POSTGRES_USER=smart_shift
POSTGRES_PASSWORD=smart_shift_password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION=PT1H
# Set false to disable Swagger UI and generated OpenAPI in a deployed environment.
API_DOCS_ENABLED=true
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
LARK_ENABLED=false
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=
LARK_APP_ENABLED=false
LARK_APP_ID=
LARK_APP_SECRET=
LARK_API_BASE_URL=https://open.larksuite.com/open-apis
SMART_SHIFT_PUBLIC_URL=http://localhost:3000
LARK_MAX_ATTEMPTS=3
LARK_RETRY_DELAY=PT30S

SCHEDULING_TIME_LIMIT_SECONDS=8
SCHEDULING_MAX_ITERATIONS=20
SCHEDULING_RANDOM_SEED=42

# Exact addresses/CIDRs of your reverse proxies; empty ignores forwarded client-IP headers.
ATTENDANCE_TRUSTED_PROXIES=

# Optional compose.monitoring.yml overlay; create secret files with setup_monitoring.py.
PROMETHEUS_PORT=29090
GRAFANA_PORT=23001
